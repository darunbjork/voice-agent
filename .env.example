# .env.example — copy to .env and fill in values.
# Default to mock providers to avoid charges. Open-Meteo weather remains live.
# Set to false ONLY after setting provider caps (see docs/cost.md).

# Server
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://voiceagent:voiceagent@localhost:5434/voiceagent

# Redis (optional — app runs without it using in-memory counters)
REDIS_URL=redis://localhost:6380

# Cost control — READ docs/cost.md before setting VOICE_MOCK=false
VOICE_MOCK=true

# Optional: use real speech-to-text while keeping Gemini/TTS and other providers mocked.
# Requires a Deepgram API key and incurs Deepgram usage.
DEEPGRAM_LIVE=false

# Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=
# nova-3 uses keyterm prompting for the terms below; nova-2 models use boosted keywords
DEEPGRAM_MODEL=nova-3
DEEPGRAM_KEYTERMS=ChatGPT,OpenAI,n8n,RAG,MCP,Art25,LLM,TypeScript,React,Node.js,agentic,API,Gemini,Deepgram,ElevenLabs

# ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=
# Premade "Lily" — works on the free plan (library voices return 402/404 there)
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Raced against GEMINI_MODEL when it is slow (>3 s) or failing; empty disables
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Groq (https://console.groq.com) — optional non-Google last resort in the LLM chain
# (Gemini → Gemini fallback → Groq). Leave the key empty to skip Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Daily caps (UTC day). 0 disables that provider for the day.
DAILY_MAX_TOKENS=50000
# ElevenLabs characters/day; over the cap TTS routes to Deepgram Aura
DAILY_MAX_TTS_CHARS=650
# Live Deepgram STT seconds/day; over the cap clients fall back to text input
DAILY_MAX_STT_SECONDS=3600

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS allowlist for production (comma-separated, no trailing slash)
CORS_ORIGINS=

# Error tracking
SENTRY_DSN=