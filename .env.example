# .env.example — copy to .env and fill in values
# CRITICAL: VOICE_MOCK=true means NO real API calls.
# Set to false ONLY in production with spend caps active.

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://voiceagent:voiceagent@localhost:5432/voiceagent

# Redis
REDIS_URL=redis://localhost:6379

# Cost control — READ docs/cost.md before setting VOICE_MOCK=false
VOICE_MOCK=true

# Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# Auth (generate: openssl rand -hex 32)
JWT_SECRET=change_this_to_32_random_chars_minimum_abc
JWT_EXPIRES_IN=7d

# Admin HTTP Basic auth password — min 12 chars. Required for /api/v1/admin/*.
# Leave blank in local dev to disable the admin surface (returns 503).
ADMIN_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:5173

# Comma-separated allowlist for production
CORS_ORIGINS=https://darun-dev.pages.dev,https://your-api.fly.dev

# Error tracking
SENTRY_DSN=