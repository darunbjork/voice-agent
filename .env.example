# .env.example — copy to .env and fill in values.
# CRITICAL: VOICE_MOCK=true means NO real API calls.
# Set to false ONLY after setting provider caps (see docs/cost.md).

# Server
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://voiceagent:voiceagent@localhost:5434/voiceagent

# Redis (optional — app runs without it using in-memory counters)
REDIS_URL=redis://localhost:6380

# Cost control — READ docs/cost.md before setting VOICE_MOCK=false
VOICE_MOCK=true

# Per-provider live override (optional)
# GEMINI_LIVE=false

# Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS allowlist for production (comma-separated, no trailing slash)
CORS_ORIGINS=

# Error tracking
SENTRY_DSN=