    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@prisma/client": "^6.19.3",
    "@voice-agent/shared-types": "workspace:*",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "redis": "^4.7.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
