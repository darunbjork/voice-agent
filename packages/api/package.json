{
  "name": "@voice-agent/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "echo \"no lint yet\" && exit 0",
    "dev": "tsx watch src/app.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
